modules = ["nodejs-24", "python-base-3.13"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 24535
externalPort = 3001

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 NODE_ENV=production DATA_PROVIDER=mock DEMO_MODE=true node server/dist/index.mjs"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
